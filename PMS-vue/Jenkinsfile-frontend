pipeline {
    agent any

    environment {
        REMOTE_HOST = 'ubuntu@111.229.254.252'
        DEPLOY_PATH = '/var/www/html/pms'
        NODE_OPTIONS = '--max-old-space-size=2048'
    }

    stages {
        stage('安装依赖') {
            steps {
                dir('PMS-react') {
                    sh '''node -e 'if(parseInt(process.versions.node)<24)throw new Error("Node 24+ required")' '''
                    sh 'npm ci --registry=https://registry.npmmirror.com'
                }
            }
        }

        stage('打包') {
            steps {
                dir('PMS-react') {
                    sh 'npm test && npm run build'
                }
            }
        }

        stage('部署') {
            steps {
                sh '''
                    # Keep the Jenkins job's existing script path; build the React application.
                    # Back up first and retain hashed assets required by already-open tabs.
                    ssh ${REMOTE_HOST} "mkdir -p /opt/pms && tar -czf /opt/pms/frontend.bak-ci-$(date +%Y%m%d-%H%M%S).tar.gz -C /var/www/html pms"
                    scp -r PMS-react/dist/assets ${REMOTE_HOST}:${DEPLOY_PATH}/
                    scp PMS-react/dist/index.html ${REMOTE_HOST}:${DEPLOY_PATH}/.index-next.html
                    ssh ${REMOTE_HOST} "mv ${DEPLOY_PATH}/.index-next.html ${DEPLOY_PATH}/index.html"
                '''
            }
        }
    }
}

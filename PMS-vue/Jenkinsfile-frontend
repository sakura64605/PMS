pipeline {
    agent any

    environment {
        REMOTE_HOST = 'ubuntu@YOUR_SERVER_IP'
        DEPLOY_PATH = '/var/www/html/pms'
    }

    stages {
        stage('安装依赖') {
            steps {
                dir('PMS-vue') {
                    sh 'npm install --registry=https://registry.npmmirror.com'
                }
            }
        }

        stage('打包') {
            steps {
                dir('PMS-vue') {
                    sh 'npm run build'
                }
            }
        }

        stage('部署') {
            steps {
                sh '''
                    ssh ${REMOTE_HOST} "sudo mkdir -p ${DEPLOY_PATH}"
                    scp -r PMS-vue/dist/* ${REMOTE_HOST}:${DEPLOY_PATH}/
                    ssh ${REMOTE_HOST} "sudo systemctl reload nginx"
                '''
            }
        }
    }
}
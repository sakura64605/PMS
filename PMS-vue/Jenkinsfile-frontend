pipeline {
    agent any

    environment {
        REMOTE_HOST = 'ubuntu@YOUR_SERVER_IP'
        DEPLOY_PATH = '/var/www/html/pms'
        NODE_OPTIONS = '--max-old-space-size=2048'
    }

    stages {
        stage('安装依赖') {
            steps {
                dir('PMS-vue') {
                    sh 'npm ci --registry=https://registry.npmmirror.com || npm install --registry=https://registry.npmmirror.com'
                }
            }
        }

        stage('打包') {
            steps {
                dir('PMS-vue') {
                    sh 'npm run build'
                }
            }
        }

        stage('部署') {
            steps {
                sh '''
                    # 确保远程目录存在且有正确权限
                    ssh ${REMOTE_HOST} "sudo mkdir -p ${DEPLOY_PATH} && sudo chown -R ubuntu:ubuntu ${DEPLOY_PATH}"
                    # 上传文件
                    scp -r PMS-vue/dist/* ${REMOTE_HOST}:${DEPLOY_PATH}/
                    # 重载 Nginx
                    ssh ${REMOTE_HOST} "sudo systemctl reload nginx || true"
                '''
            }
        }
    }
}